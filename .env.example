# Copy this file to .env and fill in real values. .env is gitignored.

# Gemini API key, used by app/llm_client.py for query understanding, complexity
# classification fallback, explanation generation, and (optionally) richer synthetic
# corpus content generation. The system runs end-to-end without this set — LLM-backed
# steps fall back to rule-based / template logic when it's absent.
GEMINI_API_KEY=

# Optional: override the default model (see app/llm_client.py for the default).
GEMINI_MODEL=gemini-2.5-flash
